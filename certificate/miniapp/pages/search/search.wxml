<!--pages/account/aboutus/aboutus.wxml-->
<!-- 搜索页 -->
<view class='container'>
  <view class='page-content'>
    <view class="column-center">
      <image class="logo" src="../../images/logo.jpg" mode="widthFix" />
      <view class="search-input-container">
        <input class="search-input" value="{{ inputCert }}" placeholder="输入查询码" placeholder-class="input-placeholder" bindblur="search" bindconfirm="search" bindinput="bindCertInput" maxlength="20" />
        <image bindtap="search" class="searchImg" src="../../images/search.png" mode="aspectFit" />
      </view>
    </view>
  </view>
</view>