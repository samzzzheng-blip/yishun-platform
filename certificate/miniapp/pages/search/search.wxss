/* pages/account/aboutus/aboutus.wxss */
.logo{
  width: 60vw;
  margin-top: 100rpx;
}
.search-input-container {
  position:relative;
  justify-content: center;
  align-items: center;
  flex-direction: row;
  display: flex;
}
.search-input{
  width: 450rpx;
  border: 1px #cccccc solid;
  border-radius: 8px;
  padding-left: 10px;
  color: #333333;
  line-height: 50rpx;
  height: 70rpx;
}
.searchImg {
  width: 30rpx;
  height: 30rpx;
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  z-index: 10;
}